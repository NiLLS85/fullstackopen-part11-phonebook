{
  "name": "phonebook",
  "version": "1.0.0",
  "description": "Agenda telefónica de Full Stack Open (partes 2 y 3) con su propio pipeline de CI/CD (parte 11)",
  "main": "index.js",
  "scripts": {
    "start": "NODE_ENV=production node index.js",
    "start:test": "NODE_ENV=test node index.js",
    "dev": "node --watch index.js",
    "build": "npm install --prefix frontend && npm run build --prefix frontend",
    "lint": "eslint . && npm run lint --prefix frontend",
    "test": "NODE_ENV=test node --test --test-concurrency=1 tests/*.test.js",
    "test:frontend": "npm test --prefix frontend",
    "test:e2e": "playwright test"
  },
  "author": "NiLLS85",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "mongoose": "^9.13.1",
    "morgan": "^1.12.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@stylistic/eslint-plugin": "^6.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "supertest": "^7.1.4"
  },
  "type": "commonjs"
}
